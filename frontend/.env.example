# ==============================================================================
# DarGlobal Intelligence Frontend (Next.js 14) - Vercel Environment Variables
# ==============================================================================

# Public API URL for browser direct client fetch (SSE streaming + REST):
# In Development: /api/v1 (proxied via next.config.mjs to localhost:8000)
# In Production (Vercel): Set to your Render Web Service URL:
# Example: https://darglobal-intelligence-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://<your-render-service-name>.onrender.com/api/v1

# Backend origin for Next.js internal rewrites:
BACKEND_INTERNAL_URL=https://<your-render-service-name>.onrender.com

# ==============================================================================
# DarGlobal Intelligence Frontend (Next.js 14) - Vercel Environment Variables
# ==============================================================================

# Backend API URL (Public removed from name for simpler Vercel configuration):
# Example: https://darglobal-gp9o.onrender.com
API_URL=https://<your-render-service-name>.onrender.com

# Both API_URL and NEXT_PUBLIC_API_URL are supported interchangeably:
NEXT_PUBLIC_API_URL=https://<your-render-service-name>.onrender.com

# ==============================================================================
# DarGlobal Intelligence - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Configure in Render Web Service Dashboard)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000

# OpenRouter Free LLM Gateway
# Optional: if left blank, the system automatically discovers and selects active :free models
# Example: sk-or-v1-abcdef1234567890...
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
AUTO_SELECT_FREE_MODEL=true

# Storage & Ephemeral Restoration Paths
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
BM25_INDEX_PATH=./data/bm25_index.pkl
CANONICAL_DATASET_PATH=./backend/data/canonical_dataset.json
RAW_DATA_DIRECTORY=./data/raw_scraped
SEED_DATA_DIRECTORY=./data/seed

# Production CORS Security Configuration
# Set to your Vercel production domain and local dev URL (comma-separated):
# Example: https://darglobal-intelligence.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Regex to permit all Vercel preview branch deployments automatically:
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Administrative Ingestion Security Key (Protects /api/v1/ingest/trigger)
# Example: 32-character random string (Render generates this automatically via render.yaml)
ADMIN_API_KEY=change_me_to_a_secure_random_key

# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Dashboard)
# ------------------------------------------------------------------------------
# Public API endpoint URL pointing to your deployed Render Web Service:
# Example: https://darglobal-intelligence-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://<your-render-service-name>.onrender.com/api/v1

# Optional internal rewrite target for Next.js server-side rewrites:
BACKEND_INTERNAL_URL=https://<your-render-service-name>.onrender.com

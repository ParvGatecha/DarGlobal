# DarGlobal Intelligence Configuration
# Copy this file to .env and adjust as necessary

# OpenRouter LLM Configuration
# Optional: if left blank, the system automatically discovers and selects active :free models
OPENROUTER_API_KEY=
# Leave blank to auto-detect active free models (e.g. google/gemma-4-31b-it:free)
OPENROUTER_MODEL=

# Vector Database (ChromaDB) Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# BM25 Lexical Store Configuration
BM25_INDEX_PATH=./data/bm25_index.pkl
BM25_PERSIST_PATH=./data/bm25_index.pkl

# Raw Scraped Data Cache
RAW_DATA_DIRECTORY=./data/raw_scraped

# Server Port and Host
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
